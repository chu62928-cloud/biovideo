{
  "type": "object",
  "required": [
    "scene_id",
    "topic_id",
    "audience",
    "objects",
    "assemblies",
    "relations",
    "events",
    "state_transitions",
    "constraints",
    "assets",
    "evidence_refs"
  ],
  "properties": {
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "object_type",
          "scientific_identity",
          "scientific_properties",
          "visual_representation",
          "anchors",
          "evidence_ids"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "object_type": {
            "type": "string",
            "minLength": 1
          },
          "scientific_identity": {
            "type": "object",
            "required": [
              "name",
              "kind",
              "origin_id"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "origin_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "scientific_properties": {
            "type": "object"
          },
          "visual_representation": {
            "type": "object"
          },
          "anchors": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assembly_id",
          "assembly_type",
          "component_ids",
          "relations",
          "state_variables",
          "anchor_points",
          "visual_representation",
          "allowed_transitions",
          "invariants",
          "evidence_ids"
        ],
        "properties": {
          "assembly_id": {
            "type": "string",
            "minLength": 1
          },
          "assembly_type": {
            "type": "string",
            "minLength": 1
          },
          "component_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source",
                "target",
                "type"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "state_variables": {
            "type": "object"
          },
          "anchor_points": {
            "type": "object"
          },
          "visual_representation": {
            "type": "object"
          },
          "allowed_transitions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "type"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "caption",
          "transition_ids",
          "duration"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "transition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duration": {
            "type": "number",
            "minimum": 0.1
          }
        },
        "additionalProperties": true
      }
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transition_id",
          "process_id",
          "assembly_id",
          "operation",
          "targets",
          "params",
          "duration",
          "preconditions",
          "postconditions",
          "invariants",
          "evidence_ids"
        ],
        "properties": {
          "transition_id": {
            "type": "string",
            "minLength": 1
          },
          "process_id": {
            "type": "string",
            "minLength": 1
          },
          "assembly_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "attach",
              "detach",
              "connect",
              "disconnect",
              "transform_state",
              "move_along_path",
              "extend",
              "split",
              "merge",
              "replace_component"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "params": {
            "type": "object"
          },
          "duration": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 20
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}