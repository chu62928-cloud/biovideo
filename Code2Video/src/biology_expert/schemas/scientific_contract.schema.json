{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_id",
    "topic_id",
    "scope",
    "scientific_entities",
    "required_processes",
    "required_observations",
    "constraints",
    "evidence_refs",
    "visual_references",
    "coverage_requirements",
    "unresolved_questions",
    "verification_plan"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "user_request",
        "audience",
        "included",
        "excluded"
      ],
      "properties": {
        "user_request": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "included": {
          "type": "array"
        },
        "excluded": {
          "type": "array"
        }
      }
    },
    "scientific_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "description",
          "evidence_ids"
        ]
      }
    },
    "required_processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "description",
          "evidence_ids"
        ]
      }
    },
    "required_observations": {
      "type": "array",
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "constraint_id",
          "type",
          "participant_roles",
          "applies_to",
          "when",
          "must_hold",
          "exceptions",
          "evidence_ids",
          "support",
          "verification",
          "severity",
          "verification_status",
          "disputed"
        ],
        "properties": {
          "constraint_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "STRUCTURAL",
              "STATE",
              "TEMPORAL",
              "PERSISTENT_RELATION",
              "VISUAL_SEMANTICS"
            ]
          },
          "participant_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applies_to": {
            "type": "object"
          },
          "when": {
            "type": "object"
          },
          "must_hold": {
            "type": "object"
          },
          "exceptions": {
            "type": "array"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "evidence_id",
                "quote"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 12
                }
              }
            }
          },
          "verification": {
            "type": "object",
            "required": [
              "methods",
              "capability",
              "primitive"
            ],
            "properties": {
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "capability": {
                "enum": [
                  "DETERMINISTIC",
                  "PARTIAL",
                  "VLM",
                  "HUMAN",
                  "UNSUPPORTED"
                ]
              },
              "primitive": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "verification_status": {
            "enum": [
              "PROPOSED",
              "SOURCE_SUPPORTED",
              "INDEPENDENTLY_VERIFIED",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "disputed": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "visual_references": {
      "type": "array"
    },
    "coverage_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "kind",
          "constraint_ids",
          "critical"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "entity",
              "relation",
              "process",
              "temporal",
              "persistent"
            ]
          },
          "constraint_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical": {
            "type": "boolean"
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array"
    },
    "verification_plan": {
      "type": "object"
    }
  }
}