  "issue_resolution": [
    {
      "issue_id": "ISS_001",
      "changed_target_ids": [
        "PROC_PRIMER_REMOVAL",
        "ENT_RNASE_H"
      ],
      "reason": "Source explicitly parenthesizes 'RNase H (AKA flap endonuclease)'; no distinction is supported. Entity retained with unresolved identity; ST_PRIMER_REMOVED records source wording without asserting single-actor mechanism. OBS_PRIMER_REMOVED remains PARTIAL/INSUFFICIENT per review.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    },
    {
      "issue_id": "ISS_002",
      "changed_target_ids": [
        "PROC_POL_ALPHA_EXTENSION",
        "PROC_POL_DELTA_EXTENSION"
      ],
      "reason": "Source says pol α hands off to 'a second polymerase' without naming pol δ as lagging-strand recipient. ST_HANDOFF_READY is modeled as generic handoff; direct α→δ assignment is flagged as schematic inference in state uncertainty and precondition text. Pol δ lagging-strand synthesis is separately source-supported.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    },
    {
      "issue_id": "ISS_003",
      "changed_target_ids": [
        "PROC_PRIMER_REPLACEMENT",
        "ENT_DNA_REPLACEMENT_PRODUCT",
        "ST_REPLACEMENT_DNA_SYNTHESIZED",
        "ST_GAP_SUBSTRATE_READY",
        "PROC_LIGATION"
      ],
      "reason": "Review identified that externalizing replacement creates a false jump from primer removal to ligation. Added a generic replacement process (PROC_PRIMER_REPLACEMENT) supported by source 'replaced with DNA nucleotides', with product entity and produced state. Polymerase identity remains unresolved/unspecified in source and is not asserted. Ligation precondition now references produced state ST_GAP_SUBSTRATE_READY.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    },
    {
      "issue_id": "ISS_004",
      "changed_target_ids": [
        "PROC_POL_DELTA_EXTENSION",
        "PROC_PRIMER_REMOVAL",
        "ST_PRIMER_DISPLACED"
      ],
      "reason": "Explicit state ST_PRIMER_DISPLACED produced by pol delta extension and required by primer removal; primer removal terminates this state. Reviewer noted same-fragment vs downstream-fragment ambiguity for displaced primer; model preserves source wording and flags uncertainty rather than asserting fragment identity.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    },
    {
      "issue_id": "ISS_005",
      "changed_target_ids": [
        "PROC_LIGATION",
        "ENT_GAP_SUBSTRATE",
        "ST_GAP_SUBSTRATE_READY",
        "ST_GAPS_SEALED"
      ],
      "reason": "Gap substrate remains a simplified nucleic-acid-region placeholder; no distinct nicked backbone state asserted. ST_GAP_SUBSTRATE_READY acknowledges replacement completion; ST_GAPS_SEALED records source-supported sealed outcome.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    },
    {
      "issue_id": "STATE_MODEL_MIGRATION",
      "changed_target_ids": [
        "ENT_DNA_TEMPLATE",
        "PROC_PRIMER_FORMATION",
        "PROC_POL_ALPHA_EXTENSION",
        "PROC_POL_DELTA_EXTENSION",
        "PROC_PRIMER_REMOVAL",
        "PROC_LIGATION",
        "PROC_PRIMER_REPLACEMENT"
      ],
      "reason": "Added ENT_DNA_TEMPLATE because ST_DNA_TEMPLATE_AVAILABLE references it. Added typed precondition/effect state refs across all included processes. Added replacement process and states to close review-identified gap between primer removal and ligation. Only state slots required by included mechanisms created; no excluded process silently modeled as included; initial condition limited to source-supported template availability.",
      "evidence_ids": [
        "E_d8ffea5a5785"
      ]
    }
  ]
}