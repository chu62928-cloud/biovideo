{
  "model_id": "dna_replication_local_eukaryotic_priming_extension_maturation_v1",
  "schema_version": "1.1",
  "scope": {
    "topic": "dna replication",
    "organism_context": "eukaryote",
    "audience": "grades_10_12",
    "included_processes": [
      "primer formation by primase",
      "DNA polymerase alpha adding a short DNA fragment to the RNA primer",
      "lagging-strand Okazaki fragment synthesis by DNA polymerase delta",
      "displacement and removal of primer RNA by RNase H on the lagging strand",
      "sealing of remaining gaps by DNA ligase"
    ],
    "excluded_processes": [
      "origin recognition and pre-replication complex assembly",
      "helicase unwinding and topoisomerase supercoiling relief",
      "leading-strand continuous synthesis by DNA polymerase epsilon",
      "telomerase-mediated telomere elongation",
      "nucleosome/histone removal and replacement",
      "proofreading and mismatch repair"
    ],
    "simplifications": [
      "The model depicts one local lagging-strand region; strand geometry and fork movement are not modeled.",
      "Polymerase hand-off after pol alpha is shown as a sequential process, not as a molecular mechanism.",
      "The sliding clamp (PCNA) is omitted as a separate entity because its exact mechanistic role is not needed for the described local maturation event.",
      "Replacement of removed RNA primer with DNA nucleotides is represented as a gap-filling product state, not as a separate polymerase process.",
      "RNase H and flap endonuclease identities remain unresolved; the model does not assert they are equivalent activities."
    ]
  },
