      "target_events": [
        "anaphase_chromatid_separation_1"
      ],
      "repair_scope": "affected_event",
      "acceptance_criteria": [
        "anchor distance(microtubule_left.end, kinetochore_A.center) <= 0.04 at every sampled time in anaphase",
