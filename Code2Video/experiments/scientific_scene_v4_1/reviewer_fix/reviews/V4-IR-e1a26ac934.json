{
  "review_id": "V4-IR-e1a26ac934",
  "stage": "SCENE_IR",
  "decision": "REVISE",
  "issues": [
    {
      "issue_id": "polarity_template_labels_inverted",
      "severity": "blocker",
      "description": "Template polarity labels conflict with a coherent antiparallel fork. template_leading is labeled 3'→5' (start left 3', end right 5') and template_lagging 5'→3'. With the helicase junction at the right and the opened region to the left, leading synthesis that proceeds 5'→3' toward the fork requires the leading template to be read 3'→5' left-to-right, i.e., its end near the fork should be 3', not 5'. As drawn, new_leading grows rightward (its 3' end at 'end'), but the adjacent template end is labeled 5', so the label pair is inverted. The lagging template's right-side 3' and its fragments growing leftward are consistent; only the leading/template pair is wrong.",
      "root_cause_stage": "SCENE_IR",
      "target_objects": [
        "template_leading",
        "template_lagging",
        "new_leading"
      ],
      "target_events": [
        "event_1_fork",
        "event_3_extension"
      ],
      "repair_scope": "Fix endpoint_labels in SCENE_IR only: set template_leading start=5', end=3' on the drawn path (or relabel the synthesis direction), keeping template_lagging 5'→3' left-to-right. Do not change geometry, animations, or approved materials.",
      "acceptance_criteria": [
        "template_leading readable 3'→5' by polymerase traveling toward the junction; new_leading grows 5'→3' with its 3' end adjacent to the template 3' end region",
        "template_lagging remains 5'→3' left-to-right with fragments growing toward the left",
        "No reverse of fragment_1/fragment_2 growth directions",
        "Re-run deterministic polarity checks and section-4 review"
      ]
    },
    {
      "issue_id": "ligase_label_mechanism_ambiguity",
      "severity": "minor",
      "description": "Maturation caption says 'Remove RNA, fill DNA, then seal a nick' and ligase seals the gap_fill/fragment_1 nick, but the RNA-primer removal step has no explicit enzyme/step shown and Pol δ is reused for gap fill after being hidden. This is within declared simplification scope (RNaseH/FEN1 omitted) but the caption should not imply the shown Pol δ performs primer removal.",
      "root_cause_stage": "SCENE_IR",
      "target_objects": [
        "polymerase_lagging",
        "ligase",
        "rna_primer_lagging_1",
        "gap_fill"
      ],
      "target_events": [
        "event_5_maturation"
      ],
      "repair_scope": "Caption/label only; keep omission of RNaseH/FEN1 as allowed simplification, but clarify RNA removal is an unshown prerequisite step and that Pol δ fills the gap.",
      "acceptance_criteria": [
        "Caption does not attribute RNA primer removal to Pol δ or ligase",
        "Declared simplification for RNaseH/FEN1 remains explicit",
        "Ligase still seals only the gap_fill/fragment_1 nick at coincident endpoints"
      ]
    },
    {
      "issue_id": "final_caption_scope_unverified",
      "severity": "uncertain",
      "description": "event_5 caption 'Remove RNA, fill DNA, then seal a nick' and overall title are fine under the declared one-local-fork scope, but no final caption text is provided to confirm it does not claim the whole genome/replication is complete while other primers remain visible. This ambiguity affects teaching mechanism integrity and cannot be auto-passed.",
      "root_cause_stage": "ASSEMBLY",
      "target_objects": [
        "rna_primer_lagging_2",
        "rna_primer_leading"
      ],
      "target_events": [
        "event_5_maturation"
      ],
      "repair_scope": "Provide/verify final caption and on-screen labels against the declared simplification 'final caption must not claim all replication completed'.",
      "acceptance_criteria": [
        "Final caption states only one local maturation shown",
        "No claim of genome-wide or fork-wide completion",
        "Other primers remain visible and unmodified"
      ]
    }
  ],
  "notes": [
    "Positive: exactly two parental strands, antiparallel pairing rungs, junction helicase placement, leading continuous rightward growth, lagging fragments leftward growth, primer-before-extension preconditions, and coincident gap_fill/fragment_1 nick endpoints are all consistent with the teaching model.",
    "Polarity rule_id: DNA_STRAND_POLARITY. Leading template must be 3' toward the fork so Pol ε (new 5'→3') reads it 3'→5' toward the junction; current template_leading endpoint labels invert this.",
    "Allowed simplifications honored: schematic geometry, Pol ε leading model hedge, one local maturation, no telomerase/chromosome-end claim. Do not demand RNaseH/FEN1 or licensing here."
  ],
