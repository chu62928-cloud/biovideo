      "issue_id": "SCI-E5-FILL-DIRECTION",
      "severity": "blocker",
      "category": "scientific_mechanism",
      "description": "Event-5 gap filling grows in the wrong chemical direction. Lower template is 5'(left)->3'(right), so the nascent lagging strand must elongate right->left (its 3' end is at the left, as the video's own lbl_lag3 and Okazaki-1 growth correctly show). Measured fill additions go left->right (x=2.092 -> 2.275 -> 2.458), i.e. projections on the template-reading vector [-1,0] are negative (-0.183, -0.183). This depicts 3'->5' addition / extension from a 5' phosphate end. Correct repair: nucleate fill at the 3' end of the downstream fragment (okazaki_fragment_2 side, larger x) and add successively toward smaller x.",
      "object_ids": [
        "fill_dna_00",
        "fill_dna_01",
        "fill_dna_02",
        "dna_polymerase_fill",
        "new_lagging_strand"
      ],
      "evidence_ids": [
        "F6",
        "F5"
      ],
      "artifact_evidence": {
        "video_timestamp": 28.53,
        "observation": "Green fill blocks appear first at the LEFT edge of the ex-primer gap (~x=2.09) and then progressively to the right (~2.28, ~2.46) between 28.5 s and 29.1 s; frame 29.2 s shows the left part of the gap filled and the right part still empty."
      },
      "root_cause_stage": "ANIMATION_CODE",
      "suggested_repair_scope": "affected_event"
    },
